# Formulários do Cognizy que recebem os leads.
# BOFU: landing principal (/). VIDEO: landing /video.
# Os dois formulários têm campos diferentes, por isso cada página só envia
# para o seu próprio form.
# Sem nenhuma delas, a rota valida o payload e registra o lead apenas no log.
COGNIZY_BOFU_FORM_URL=https://api.cognizy.ai/api/public/forms/bofu-landingpage/submit
COGNIZY_VIDEO_FORM_URL=https://api.cognizy.ai/api/public/forms/mofu-landingpage/submit

# Meta (Facebook) Pixel ID. Se não definir, o pixel não será carregado (útil em dev).
NEXT_PUBLIC_META_PIXEL_ID=1450968547067516

# Token de acesso da Conversion API (Meta). Gere em: Gerenciador de Eventos > Pixel > Configurações > Conversion API.
# Se não definir, conversões server-side não serão enviadas.
META_CONVERSION_API_ACCESS_TOKEN=

# URL base do site (ex: https://mylarpro.com.br). Usada na Conversion API como event_source_url.
# Opcional; em Vercel pode usar VERCEL_URL para montar a URL.
NEXT_PUBLIC_SITE_URL=

# Vídeo da landing /video (o caminho do lead das 23h40 até o corretor certo).
# Sirva por CDN em produção. Sem esta variável, a página mostra o aviso de
# "vídeo em finalização" no lugar do player.
NEXT_PUBLIC_LEAD_VIDEO_URL=
NEXT_PUBLIC_LEAD_VIDEO_POSTER=
